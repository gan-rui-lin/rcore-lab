# LoongArch64-specific build configuration
# Sourced by main Makefile when ARCH=loongarch64

TARGET := loongarch64-unknown-none
KERNEL_ELF := target/$(TARGET)/$(MODE)/os
FS_IMG := ../user/target/$(TARGET)/$(MODE)/fs.img

# Binutils - use LLVM tools for LoongArch
OBJDUMP := rust-objdump --arch-name=loongarch64
OBJCOPY := rust-objcopy --binary-architecture=loongarch64

# QEMU configuration for LoongArch
QEMU := qemu-system-loongarch64
QEMU_ARGS := -machine virt \
	-cpu la464-loongarch-cpu \
	-m 128M \
	-nographic \
	-kernel $(KERNEL_ELF) \
	-drive file=$(FS_IMG),if=none,format=raw,id=x0 \
	-device virtio-blk-device,drive=x0,bus=virtio-mmio-bus.0

.PHONY: run-loongarch build-loongarch kernel-loongarch

build-loongarch: env kernel-loongarch

kernel-loongarch:
	@echo "Building LoongArch64 kernel..."
	@LOG=$(LOG) cargo build $(MODE_ARG) --target $(TARGET) \
		-Zbuild-std=core,alloc,compiler_builtins \
		-Zbuild-std-features=compiler-builtins-mem

run-loongarch: build-loongarch
	@echo "Running LoongArch64 kernel in QEMU..."
	@$(QEMU) $(QEMU_ARGS)
